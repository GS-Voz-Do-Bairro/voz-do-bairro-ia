# Copie para .env (que NÃO vai para o Git) e preencha. Nunca coloque chaves no código.

# Chave da OpenAI (GPT, Whisper e embeddings). Sem ela o serviço roda em modo local:
# embeddings TF-IDF + textos-modelo no lugar do LLM, e a transcrição de áudio fica indisponível.
OPENAI_API_KEY=

# Chave exigida no cabeçalho X-API-Key por todas as rotas, exceto /health. OBRIGATÓRIA em produção.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_API_KEY=

# Opcionais
# VOZIA_EMBEDDER=openai        # openai | tfidf (padrão: openai se houver chave, senão tfidf)
# VOZIA_LLM_MODEL=gpt-4o-mini
# VOZIA_EMBED_MODEL=text-embedding-3-small
# VOZIA_STT_MODEL=whisper-1
